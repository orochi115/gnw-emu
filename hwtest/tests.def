/*
 * Test ids.  parse.py reads this file, so keep one T(...) per line.
 * T(id, NAME, unit)  -- unit says what "ops" counts in a result entry.
 * Kernel tests use the generated k_<name> kernels; ids must stay stable.
 */
T(0,  empty,        iter)
T(1,  nop,          insn)
T(2,  add_dep,      insn)
T(3,  add_indep,    insn)
T(4,  addw_indep,   insn)
T(5,  mul_dep,      insn)
T(6,  mul_indep,    insn)
T(7,  mla_dep,      insn)
T(8,  udiv_max,     insn)
T(9,  udiv_min,     insn)
T(10, sdiv_max,     insn)
T(11, b_taken,      insn)
T(12, vadd_dep,     insn)
T(13, vmul_dep,     insn)
T(14, vfma_dep,     insn)
T(15, vdiv_dep,     insn)
T(16, vsqrt_dep,    insn)
T(17, vadd64_dep,   insn)
T(18, vdiv64_dep,   insn)
T(19, vsqrt64_dep,  insn)
T(20, ld_lat,       load)
T(21, alu2_lat,     step)
T(22, ld_tput,      load)
T(23, ld_seq,       load)
T(24, ld_line,      load)
T(25, ld_lat_line,  load)
T(26, ldm_seq,      ldm8)
T(27, st_seq,       store)
T(28, st_same,      store)
T(29, fetch_nop,    insn)
T(30, fetch_addw,   insn)
T(31, fetch_empty,  iter)
/* Peripherals and clocks (region = 0, cfg = cache config) */
T(40, rtc_hz,       rtc_ticks)
T(41, systick_cpu,  systick_counts)
T(42, systick_ref,  systick_counts)
T(43, tim2,         tim_counts)
T(44, ltdc_frame,   frames)
T(45, ltdc_lines,   lines)
T(50, dma2d_r2m,    pixels)
T(51, dma2d_m2m,    pixels)
T(52, dma2d_pfc,    pixels)
T(53, dma2d_blend,  pixels)
T(54, dma1_m2m,     words)
T(55, dma1_m2m_b4,  words)
T(56, cryp_ecb,     blocks)
T(60, irq_entry,    irq)
T(61, irq_return,   irq)
T(62, irq_entry_fp, irq)
T(63, irq_return_fp, irq)
T(64, cpu_memcpy,   bytes)
