{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src", "tools", "tests", "*.ts"],
  "exclude": [
    "tools/compare-kernels.ts",
    "tools/kernel-comparison.ts",
    "tests/integration/kernel-comparison.test.ts",
    "src/core/qemu-command.ts",
    "tests/unit/qemu-command.test.ts"
  ]
}
