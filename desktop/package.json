{
  "name": "gnw-emu-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "esbuild tools/cli.ts tools/ui-cli.ts --bundle --platform=node --format=esm --outdir=dist-cli --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:windows-clock": "node tools/verify-windows-clock.mjs",
    "package:dir": "npm run build && node tools/stage-qemu.mjs && electron-builder --dir",
    "package:portable": "npm run build && node tools/stage-qemu.mjs && electron-builder --win zip --config electron-builder.portable.yml",
    "format": "prettier --write src tools tests *.ts *.json"
  },
  "dependencies": {
    "i18next": "^27.0.1",
    "koffi": "^3.3.8",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "description": "Game & Watch emulator desktop",
  "author": "gnw-emu contributors"
}
